# ============================================
# CyberRecon — Environment Configuration (example)
# Copy to .env and fill in real values.
# ============================================

# --- C2 Server ---
C2_HOST=0.0.0.0
C2_PORT=8443

# --- Auth ---
CYBERRECON_OPERATOR_TOKEN=change-me-to-a-long-random-string
CYBERRECON_VICTIM_KEY=change-me-victim-key
CYBERRECON_REQUIRE_AUTH=true
CYBERRECON_REQUIRE_VICTIM_KEY=true

# --- Crypto (AES-256-GCM QR payload) ---
# Generate: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CYBERRECON_KEY=change-me-44-char-base64url-key

# --- Dashboard login ---
# Generate password: python -c "import secrets,string; a=string.ascii_letters+string.digits; print(''.join(secrets.choice(a) for _ in range(24)))"
CYBERRECON_DASHBOARD_PASSWORD=change-me
# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
CYBERRECON_SECRET_KEY=change-me-64-char-urlsafe
CYBERRECON_SESSION_HOURS=8

# --- Client ---
CYBERRECON_C2=https://127.0.0.1:8443
CYBERRECON_ALLOW_SELFSIGNED=true
CYBERRECON_INTERVAL=3

# --- Sandbox ---
CYBERRECON_SANDBOX=

# --- Self-delete / anti-forensics (opt-in) ---
CYBERRECON_SELF_DELETE=0
CYBERRECON_ELEVATED_WIPE=0
CYBERRECON_REMOVE_DECOY=0